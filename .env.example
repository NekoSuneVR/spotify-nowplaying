PORT=3000
PUBLIC_BASE_URL=https://spnp.nekosunevr.co.uk
STALE_AFTER_MS=45000

# sqlite is the default. It uses Node 24's built-in SQLite, not the native sqlite3 npm package.
DATABASE_DIALECT=sqlite
SQLITE_STORAGE=./data/nowplaying.sqlite

# Optional MySQL config. Pterodactyl database variables DB_HOST, DB_PORT,
# DB_DATABASE, DB_USERNAME, and DB_PASSWORD are also supported automatically.
# DATABASE_DIALECT=mysql
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_NAME=spotify_nowplaying
# DATABASE_USER=spotify_nowplaying
# DATABASE_PASSWORD=change-me

# Optional PostgreSQL config. You can use DATABASE_DIALECT=postgresql or postgres.
# DATABASE_DIALECT=postgresql
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=spotify_nowplaying
# DATABASE_USER=spotify_nowplaying
# DATABASE_PASSWORD=change-me

# Optional single connection URL. Overrides host/name/user/password settings.
# DATABASE_URL=postgres://spotify_nowplaying:change-me@127.0.0.1:5432/spotify_nowplaying

# Optional one-time import path for old JSON installs.
# LEGACY_JSON_PATH=./data/db.json
